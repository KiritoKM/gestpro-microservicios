[Unit]
Description=GestPro Sales and Analytics Microservice
After=network.target

[Service]
User=gestpro
WorkingDirectory=/opt/gestpro/backend/service_sales_analytics
ExecStart=/opt/gestpro/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8003
Restart=always
RestartSec=3
Environment="PYTHONUNBUFFERED=1"
Environment="SALES_DB_PATH=/opt/gestpro/data/sales.db"

[Install]
WantedBy=multi-user.target
