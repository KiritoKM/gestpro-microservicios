[Unit]
Description=GestPro Inventory and Catalog Microservice
After=network.target

[Service]
User=gestpro
WorkingDirectory=/opt/gestpro/backend/service_inventory
ExecStart=/opt/gestpro/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8002
Restart=always
RestartSec=3
Environment="PYTHONUNBUFFERED=1"
Environment="INVENTORY_DB_PATH=/opt/gestpro/data/inventory.db"

[Install]
WantedBy=multi-user.target
